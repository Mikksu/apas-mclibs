
main:

	GLOBAL DIM IsEMBPressed
	
	DIM myModule, myId
	
	IsEMBPressed = 0
	
	PRINT CONTROL + SERIAL_NUMBER
	
	
	'ECatADInit
	AxisInit


	RUNTASK 1, EMER_TASK

End


'初始化EtherCat总线AD采集模块
